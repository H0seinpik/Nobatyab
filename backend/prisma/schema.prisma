generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PROVIDER
  ADMIN
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProviderRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  PROVIDER_REQUEST_APPROVED
  PROVIDER_REQUEST_REJECTED
  SERVICE_REQUEST_APPROVED
  SERVICE_REQUEST_REJECTED
  NEW_APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED_BY_USER
  NEW_PROVIDER_REQUEST
  NEW_SERVICE_REQUEST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  firstName    String?
  lastName     String?
  nationalCode String?  @unique
  age          Int?
  address      String?
  phone        String?  @unique
  smsEnabled   Boolean  @default(true)
  emailEnabled Boolean  @default(true)
  avatarUrl    String?
  latitude     Float?
  longitude    Float?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  providerProfile  ProviderProfile?
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]
  appointments     Appointment[]      @relation("BookedByUser")
  serviceRequests   ServiceRequest[]
  providerRequests  ProviderRequest[]
  availabilities    UserAvailability[]
  bookingRequests  BookingIdempotency[]
  reviews          Review[]
  notifications    Notification[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]

  providerRequests            ProviderRequest[]
  createdFromProviderRequests ProviderRequest[] @relation("CreatedFromProviderRequest")
}

model Service {
  id              String   @id @default(cuid())
  categoryId      String
  name            String
  description     String?
  defaultDuration Int
  basePrice       Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerServices ProviderService[]
  serviceRequests  ServiceRequest[]
  createdFromProviderRequests ProviderRequest[] @relation("CreatedFromProviderRequest")
}

model ProviderProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  specialization      String?
  bio                 String?
  address             String?
  latitude            Float?
  longitude           Float?
  slotDurationMinutes Int      @default(30)
  isAcceptingBookings Boolean  @default(true)
  avgRating           Float    @default(0)
  reviewCount         Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cancellationPolicy CancellationPolicy?
  providerServices   ProviderService[]
  appointments       Appointment[]
  serviceRequests    ServiceRequest[]
  timeSlots          TimeSlot[]
  reviews            Review[]
}

model ProviderService {
  id         String  @id @default(cuid())
  providerId String
  serviceId  String
  price      Decimal @db.Decimal(10, 2)
  duration   Int
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service      Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  workingHours WorkingHours[]
  timeSlots    TimeSlot[]

  @@unique([providerId, serviceId])
}

model ServiceRequest {
  id                  String               @id @default(cuid())
  providerId          String
  requestedById       String
  serviceId           String?
  proposedName        String?
  proposedDescription String?
  proposedPrice       Decimal?             @db.Decimal(10, 2)
  proposedDuration    Int?
  status              ServiceRequestStatus @default(PENDING)
  adminNote           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service     Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requestedBy User            @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([status])
}

model ProviderRequest {
  id                          String                @id @default(cuid())
  userId                      String
  status                      ProviderRequestStatus @default(PENDING)
  note                        String?
  adminNote                   String?
  categoryId                  String?
  proposedCategoryName        String?
  proposedCategoryDescription String?
  createdCategoryId           String?
  proposedServiceName         String
  proposedServiceDescription  String?
  proposedServicePrice        Decimal               @db.Decimal(10, 2)
  proposedServiceDuration     Int
  createdServiceId            String?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdCategory Category? @relation("CreatedFromProviderRequest", fields: [createdCategoryId], references: [id], onDelete: SetNull)
  createdService  Service?  @relation("CreatedFromProviderRequest", fields: [createdServiceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

model WorkingHours {
  id                String   @id @default(cuid())
  providerServiceId String
  dayOfWeek         Int
  startTime         String
  endTime           String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providerService ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Cascade)

  @@index([providerServiceId, dayOfWeek])
}

model CancellationPolicy {
  id             String   @id @default(cuid())
  providerId     String   @unique
  minHoursBefore Int      @default(24)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// Partial unique index on (providerId, startAt) for non-cancelled rows — migration 20250614000000_booking_duplicate_protection
model Appointment {
  id                String            @id @default(cuid())
  providerId        String
  providerServiceId String
  userId            String?
  guestFullName     String?
  guestPhone        String?
  guestEmail        String?
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  notes             String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  provider            ProviderProfile      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService     ProviderService      @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  user                User?                @relation("BookedByUser", fields: [userId], references: [id], onDelete: SetNull)
  paymentTransactions PaymentTransaction[]
  smsLogs             SmsLog[]
  timeSlots           TimeSlot[]
  bookingIdempotency  BookingIdempotency?
  review              Review?

  @@index([providerId, startAt, endAt])
  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id            String                   @id @default(cuid())
  appointmentId String
  amount        Decimal                  @db.Decimal(10, 2)
  status        PaymentTransactionStatus
  providerKey   String
  externalRef   String?
  rawResponse   Json?
  createdAt     DateTime                 @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  label     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model SmsLog {
  id             String    @id @default(cuid())
  appointmentId  String?
  userId         String?
  notificationId String?
  phone          String
  message        String
  status         SmsStatus
  providerKey    String
  createdAt      DateTime  @default(now())

  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([notificationId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsLogs   SmsLog[]
  emailLogs EmailLog[]

  @@index([userId, readAt, createdAt])
}

model EmailLog {
  id             String      @id @default(cuid())
  email          String
  subject        String
  body           String
  status         EmailStatus
  providerKey    String
  userId         String?
  notificationId String?
  createdAt      DateTime    @default(now())

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([notificationId])
}

model UserAvailability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model TimeSlot {
  id                String   @id @default(cuid())
  providerId        String
  providerServiceId String
  date              String
  startTime         String
  endTime           String
  isBooked          Boolean  @default(false)
  isActive          Boolean  @default(true)
  appointmentId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerService ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Cascade)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([providerServiceId, date, startTime])
  @@index([providerId, date, isBooked])
  @@index([providerId, date, isActive])
  @@index([providerServiceId, date, isBooked])
  @@index([providerServiceId, date, isActive])
}

model BookingIdempotency {
  id            String   @id @default(cuid())
  key           String   @unique
  userId        String?
  appointmentId String   @unique
  createdAt     DateTime @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  userId        String
  providerId    String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([userId])
}
