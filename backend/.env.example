# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=nobatyab
DB_SCHEMA=public
# Or set directly (Prisma CLI requires DATABASE_URL):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nobatyab?schema=public

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# App
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000

# Integrations
PAYMENT_PROVIDER=simulated
SMS_PROVIDER=simulated
