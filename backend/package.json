{
  "name": "nobatyab-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "test:concurrent-booking": "tsx scripts/concurrent-booking-test.ts",
    "test": "tsx --test src/modules/smart-booking/helpers/overlap.test.ts src/modules/smart-booking/helpers/availabilityFilter.test.ts src/modules/smart-booking/helpers/expectedSlots.test.ts src/modules/smart-booking/helpers/slotReconcile.test.ts src/modules/appointments/bookingGuard.test.ts src/modules/appointments/bookingTransaction.test.ts src/modules/appointments/appointmentDuration.helpers.test.ts src/modules/provider/workingHours.helpers.test.ts src/modules/provider/provider.status.schema.test.ts src/shared/utils/queryBuilder.test.ts src/modules/user/user.changePassword.test.ts src/shared/schemas/iranianIdentity.schema.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "zod": "^3.25.67"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.30",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
